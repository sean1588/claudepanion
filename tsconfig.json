{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "incremental": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/cli/**/*", "src/host/**/*", "src/server/**/*", "src/shared/**/*", "companions/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/client", "companions/**/*.tsx", "companions/client.ts", "companions/build/templates"]
}
